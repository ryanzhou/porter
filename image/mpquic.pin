# The mpquic the image ships: this commit of github.com/ryanzhou/mpquic,
# built from source by image/build-mpquic.sh. The commit id names the
# source exactly, and Go checks the modules it depends on against the
# go.sum that comes with it.
#
# It has to be a version with the TUN interface (--tun), which is newer
# than the v0.5.0 release. Once a release carries it, this can name the
# release's commit instead.
#
# On a running router, a copy at /data/porter/bin/mpquic is used instead
# of the one in the image.
MPQUIC_COMMIT=ecd3a8b4ad45b3b71020d41aad67211b57cc08af
