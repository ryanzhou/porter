# The mpquic release the image ships (github.com/ryanzhou/mpquic), and the
# SHA-256 of its Linux binaries. To move to a newer mpquic, change the
# version and take the two hashes from that release's SHA256SUMS file.
#
# On a running router, a copy at /data/porter/bin/mpquic is used instead
# of the one in the image.
MPQUIC_VERSION=v0.5.0
MPQUIC_SHA256_arm64=efa1707edc194706ee063da1eea3f73cd69d6c23c7832ae08453eec69069c599
MPQUIC_SHA256_amd64=02b3442fd6e9d7d0ba3feafd212c335f986b8488237ddc8089df4daf866d29f0
